NEXT_PUBLIC_APP_NAME=TradingLegends

# Accounts + persistent watchlist (Phase 7/8). Free at https://supabase.com
# — create a project, then Project Settings -> API for these two values.
# Without them, the site works exactly as before: no login, watchlist
# stays in localStorage. See "Setting up accounts" in the README for the
# database schema to run in Supabase's SQL Editor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Your production URL (e.g. https://coownersproject.vercel.app), no trailing
# slash. Used so Supabase's "confirm your email" link redirects back to the
# live site instead of localhost. Also add this exact URL (plus /auth/callback)
# to Supabase -> Authentication -> URL Configuration -> Redirect URLs, and set
# it as the "Site URL" there too.
NEXT_PUBLIC_SITE_URL=

# Discord bot (Phase 6)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=

# Set to "true" to force sample data instead of live market data
# (e.g. offline development). Leave unset/false for a live site.
DEMO_MODE=

# Market data is live without this — CoinGecko's Keyless Public API and
# Binance's public API need no key. Set this to a free CoinGecko Demo API
# key (https://www.coingecko.com/en/api/pricing, no credit card) before
# going to production: it raises the CoinGecko rate limit from ~10-30
# calls/min (keyless, shared per IP) to 100 calls/min / 10,000 per month.
MARKET_API_KEY=

# News is live without any key — an RSS aggregator over official feeds
# (Cointelegraph, Decrypt, CoinDesk, CryptoSlate; see
# lib/providers/live/newsSources.ts). Unused for now; kept for a future
# paid/keyed news source if we ever add one.
NEWS_API_KEY=

# Whale monitoring (BTC + ETH only). BTC works without any key (mempool.space
# is fully free/keyless). Set this to a free Etherscan API key
# (https://etherscan.io/apis, free tier: 5 req/sec, 100,000/day) to also
# detect large native ETH transfers and large USDT/USDC transfers on
# Ethereum (most big Ethereum-chain money movement is in stablecoins, not
# native ETH) — without it, all Ethereum-side whale detection is skipped,
# not an error.
ETHERSCAN_API_KEY=

# Automated Discord alert engine (Phase 5). Posts to Discord when BTC/ETH
# move past +-5%/+-10% in 24h, or cross a round-number price level (e.g.
# every $1,000 for BTC, $100 for ETH — "BTC broke $72,000"). Price moves
# only, no news alerts. There is no personal alert builder on the site —
# this is global, not per-user. All three of these are required together;
# see README for setup.

# Free Upstash Redis (https://upstash.com, no credit card): stores which
# price threshold and which round-number level is currently active per
# asset, so the engine doesn't re-announce the same crossing every time
# it runs (checking often, e.g. every 5 min, does not mean frequent
# Discord messages — only a message per actual new crossing).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# A Discord "Incoming Webhook" URL from your TradingLegends server
# (Server Settings -> Integrations -> Webhooks -> New Webhook), pointed at
# whichever channel should receive alerts (e.g. #market-alerts).
DISCORD_WEBHOOK_URL=

# A secret you make up yourself. The scheduler (Upstash QStash) must send
# this as an `x-cron-secret` header when it calls GET /api/cron/discord-alerts
# — without a matching header, that endpoint returns 401. Keeps randoms
# from triggering it and spamming your Discord.
CRON_SECRET=
